# Production Environment Configuration
# This file is committed to git as a template
# NEVER commit real production credentials!

ENV=prod
API_BASE_URL=https://api.yourdomain.com/
# CRITICAL: Always pass production keys via build command
# flutter build apk --dart-define=ENV=prod --dart-define=MAPS_KEY=your_production_key
MAPS_KEY=YOUR_PRODUCTION_MAPS_KEY_HERE
ENABLE_LOGS=false
API_TIMEOUT=30
