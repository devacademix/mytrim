# Staging Environment Configuration
# This file is committed to git as a template
# Copy to .env.staging.local and add your actual staging values

ENV=staging
API_BASE_URL=https://staging-api.yourdomain.com/
# IMPORTANT: Do NOT commit your real staging API key
# Pass it via: flutter run --dart-define=ENV=staging --dart-define=MAPS_KEY=your_staging_key
MAPS_KEY=YOUR_STAGING_MAPS_KEY_HERE
ENABLE_LOGS=true
API_TIMEOUT=45
